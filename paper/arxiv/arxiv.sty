% arxiv.sty -- the common arXiv layout (Times, ruled title block, short-title running head). Written for the Pondus calibration paper; pdfLaTeX and XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/10/20 arXiv paper style]
\RequirePackage[letterpaper,textwidth=6.5in,textheight=9in,headheight=14pt,headsep=18pt,top=1in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{titlesec}

% running head and page numbers
\newcommand{\headeright}{}
\newcommand{\shorttitle}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\scshape \shorttitle}
\fancyhead[R]{\small\scshape \headeright}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{firstpage}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

% section headings
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .6ex minus .2ex}{1.1ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus .5ex minus .2ex}{0.8ex plus .2ex}

% title block
\makeatletter
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}
\gdef\@subtitle{}
\renewcommand{\maketitle}{%
  \thispagestyle{firstpage}%
  \begin{center}
    \rule{\linewidth}{3pt}\par\vspace{0.18in}
    {\LARGE\bfseries \@title\par}
    \ifx\@subtitle\@empty\else\vspace{0.08in}{\large \@subtitle\par}\fi
    \vspace{0.14in}\rule{\linewidth}{1pt}\par
    \vspace{0.3in}
    {\normalsize\begin{tabular}[t]{c}\@author\end{tabular}\par}
    \vspace{0.15in}{\small \@date\par}
  \end{center}
  \vspace{0.15in}}
\makeatother

% abstract and keywords
\renewenvironment{abstract}%
  {\begin{center}{\large\bfseries Abstract}\end{center}\vspace{-0.6ex}\begin{quote}\small}%
  {\end{quote}}
\newcommand{\keywords}[1]{\begin{quote}\small\textbf{\textit{Keywords}}\enspace #1\end{quote}}
\endinput
